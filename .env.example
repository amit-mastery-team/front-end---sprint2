# true  -> every screen reads from the in-memory mock layer (src/shared/api/mock)
# false -> every call goes to VITE_API_BASE_URL over HTTP (src/shared/api/httpApi.js)
VITE_USE_MOCK=true
VITE_API_BASE_URL=/api
# Artificial delay (ms) on mock calls so loading states stay visible while developing.
VITE_MOCK_LATENCY=300
